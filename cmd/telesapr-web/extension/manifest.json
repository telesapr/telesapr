{
  "manifest_version": 3,
  "name": "TeleSAPR AI relay",
  "version": "0.1.0",
  "description": "Lets telesapr-cli mcp, and so an AI model's program, reach the drawing open in TeleSAPR's browser version.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://telesapr.sourceforge.io/app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "relay@telesapr.org", "strict_min_version": "128.0" }
  }
}

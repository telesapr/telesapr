telesapr 2

units mm

group 0x1 sketch-3d "#references" {
  color 0 0 0 0
  visible
}

group 0x2 sketch-in-plane "sketch-in-plane" {
  order 1
  subtype point-ortho
  workplane 0x80020000
  color 0 0 0 0
  predef {
    q 1 0 0 0
    origin 0x10001
  }
  visible
}

group 0x3 extrude "extrude" {
  order 2
  subtype one-sided
  op-a 0x2
  color 100 100 100 255
  predef {
    entity-b 0x80020000
  }
  visible
  remap {
    map 1 0x40000 1002
    map 2 0x40001 1002
    map 3 0x40020 1002
    map 4 0x40040 1002
    map 5 0x40000 1001
    map 6 0x40001 1001
    map 7 0x40020 1001
    map 8 0x40040 1001
    map 9 0x40001 1003
    map 10 0x80020000 1002
    map 11 0x80020000 1001

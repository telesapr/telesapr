filedialog open
formdialog Plate|&Run|Cancel
  entry width "Width (mm)" 40 [] "a number"
  entry holes "Holes" 2 [] "a whole number"
  entry name "name" plate [] ""
  check solid "Extrude" 1 [] ""
  choice finish "finish" 0 ["matte" "metal"] ""
console 4 run $testdata/ui/scriptform/plate.go\n
console 0 g004-base metal, volume 4466\n
console 3 plate.go done.\n

# Analyze > Check Solid on a sound solid, in millimetres and in inches,
# on a mesh with naked edges, and on a sketch with no solid.
load tlspr/golden/group/boolean_tangent_edge/normal.tlspr
answer ok
key o ctrl shift
dump
menu View|Dimension Units|Dimensions in Inches
answer ok
menu Analyze|Check Solid
menu View|Dimension Units|Dimensions in Millimeters
load tlspr/golden/group/force_to_mesh/fillet.tlspr
answer ok
key o ctrl shift
dump
load tlspr/golden/request/line_segment/normal.tlspr
answer ok
key o ctrl shift
dump

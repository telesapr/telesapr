# Two angles of a rectangle made equal with the mouse and the Constrain
# menu; the same as path_equal.go makes (TestPathEquivalence/equal).
key r
move 200 200
down L 200 200
up L 200 200
move 380 330
down L 380 330
up L 380 330
key esc
move 290 200
down L 290 200
up L 290 200
move 380 265
down L 380 265
up L 380 265
move 290 330
down L 290 330
up L 290 330
move 200 265
down L 200 265
up L 200 265
menu Constrain|Angle / Equal Angle

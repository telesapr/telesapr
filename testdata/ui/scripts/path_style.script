# A custom line style made on the styles screen and drawn at a level of
# its own; the same as path_style.go makes (TestPathEquivalence/style).
key r
move 200 200
down L 200 200
up L 200 200
move 380 330
down L 380 330
up L 380 330
key esc
menu Edit|Line Styles...

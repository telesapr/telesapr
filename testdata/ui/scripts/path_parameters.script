# A rectangle whose sides come from three parameters, through the
# parameters screen and the dimension editor, then extruded; the same
# model as path_parameters.go makes (TestPathEquivalence/parameters).
key r
move 200 200
down L 200 200
up L 200 200
move 380 330
down L 380 330
up L 380 330
key esc
menu Edit|Parameters...
twmove 51 130
twdown L 51 130
twup L 51 130
edit k = 4
twmove 51 150
twdown L 51 150
twup L 51 150
edit w = k*10
twmove 51 190
twdown L 51 190
twup L 51 190
edit h = w/2
move 290 330
down L 290 330
up L 290 330
key d
key esc
move 380 265
down L 380 265
up L 380 265
key d
key esc
move 290 370
down L 290 370
up L 290 370
down L 290 370
dbl L 290 370
up L 290 370
edit w
move 430 270
down L 430 270
up L 430 270
down L 430 270
dbl L 430 270
up L 430 270
edit h
key x shift

# Two edges of the extrusion of path_extrude chamfered, picked with the
# mouse; the same as path_chamfer.go makes (TestPathEquivalence/chamfer).
key r
move 200 200
down L 200 200
up L 200 200
move 380 330
down L 380 330
up L 380 330
key esc
key x shift
move 382.5 232.5
down L 382.5 232.5
up L 382.5 232.5
move 247.5 202.5
down L 247.5 202.5
up L 247.5 202.5
menu Features|Chamfer Edges

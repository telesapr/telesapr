# Two top edges of the extrusion of path_extrude that meet at a corner,
# picked with the mouse and rounded, mitred where they meet; the same as
# path_fillet_mitre.go makes (TestPathEquivalenceFilletMitre).
key r
move 200 200
down L 200 200
up L 200 200
move 380 330
down L 380 330
up L 380 330
key esc
key x shift
move 382.5 232.5
down L 382.5 232.5
up L 382.5 232.5
move 247.5 202.5
down L 247.5 202.5
up L 247.5 202.5
menu New Group|Fillet Edges

spacesolve 1

units inch

group 0x1 sketch-3d "" {
  color 0 0 0 0
}

group 0x7 helix "all \"fields\"" {
  order 3
  subtype two-skewed
  workplane 0x80020000
  op-a 0x2
  op-b 0x5
  copies = 3
  pitch = -1.25
  val-c = 1e-09
  color 1 2 3 4
  skip-first
  combine intersection
  force-to-mesh
  predef {
    q 0.5 -0.5 0.25 -0
    origin 0x10001
    entity-b 0x20001
    entity-c 0x30001
    swap-uv
    negate-u
    negate-v
  }
  visible
  suppress
  relax-constraints
  allow-redundant
  suppress-dof
  all-dims-reference
  scale 2.5
  link "dir/part.spcs"
  remap {
    map 5 0x40001 2
  }
}

request 0x1 workplane {
  group 0x1
}

request 0x9 image {
  group 0x7
  workplane 0x80020000
  construction
  style 0x100
  extra-points 2
  text "text\n"
  font "font.ttf"
  file "img.png"
  aspect-ratio 1.5
}

constraint 0x4 pt-pt-distance {
  group 0x7
  workplane 0x80020000
  value = 12.5
  param 0x40010
  pt-a 0x40001
  pt-b 0x40002
  entity-a 0x1
  entity-b 0x2
  entity-c 0x3
  entity-d 0x4
  other
  other2
  reference
  comment "why"
  label-offset 1 -2 3
  label-style 0x101
}

style 0x100 "custom" {
  width 2
  width-as mm
  text-height 11
  text-height-as mm
  text-angle 30
  text-origin left top
  color 255 0 0 255
  fill-color 0 0 9 128
  filled
  visible
  exportable
  stipple dash-dot
  stipple-scale 15
}

value 0x40010 -0
value 0x40012 -inf
value 0x40000011 1e+300

entity 0x90000 ttf-text {
  group 0x7
  workplane 0xffffffff
  construction
  style 0x100
  text "abc"
  font "f.ttf"
  file "p.png"
  points 0x90001 0x0 0x90003
  extra-points 1
  normal 0x90020
  distance 0x90030
  act-point 1e-07 2 3
  act-normal 1 0 0 0
  act-distance 4
  act-visible
}

mesh {
  triangle 0x1234 10 0 0 255 1 0 0 0 1 0 0 0 1
}

shell {
  surface 0x1 {
    color 0 7 0 0
    face 0x99
    degree 1 3
    ctrl 0 0 0 0 0.1 1
    ctrl 0 1 0 1 0.1 1
    ctrl 0 2 0 2 0.1 1
    ctrl 0 3 0 3 0.1 1
    ctrl 1 0 1 0 0.1 1
    ctrl 1 1 1 1 0.1 2
    ctrl 1 2 1 2 0.1 3
    ctrl 1 3 1 3 0.1 4
    trim 0x2 forward 1 0 0 0 1 0
    trim 0x3 backward 0 1 0 1 0 0
  }
  curve 0x2 {
    exact
    degree 2
    surfaces 0x1 0x5
    ctrl 0 0 0 0 1
    ctrl 1 1 0 0 1
    ctrl 2 2 0 0 1
    vertex 0 0 0
    point 1 0 0
    vertex 2 0 0
  }
  curve 0x3 {
    degree 1
    surfaces 0x0 0x0
  }
}

style 0x100 "@dxf-h2.5-ov3" {
  width 1.5
  text-height 2.5
  text-height-as mm
  text-origin left top
  color 255 255 255 255
  fill-color 76 76 76 255
  visible
  exportable
  stipple-scale 15
}


spacesolve 2

units mm

group 0x1 sketch-3d "#references" {
  color 0 0 0 0
  visible
}

group 0x2 sketch-in-plane "sketch-in-plane" {
  order 1
  subtype point-ortho
  color 0 0 0 0
  predef {
    q 1 0 0 0
    origin 0x10001
  }
  visible
}


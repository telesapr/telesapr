spacesolve 2

units mm

group 0x1 sketch-3d "#references" {
  color 0 0 0 0
  visible
}

group 0x2 sketch-in-plane "sketch-in-plane" {
  order 1
  subtype point-ortho
  color 0 0 0 0
  predef {
    q 1 0 0 0
    origin 0x10001
  }
  visible
}

request 0x1 workplane {
  group 0x1
}

request 0x2 workplane {
  group 0x1
}

request 0x3 workplane {
  group 0x1
}

request 0x4 line-segment {
  group 0x2
  construction
  style 0x100
}

constraint 0x1 comment {
  group 0x2
  comment "日本語ﾃｽﾄ"
  label-offset 0 -2 0
  label-style 0x101
}

style 0x100 "@dxf" {
  width 1.5
  text-height 11.5
  text-height-as mm
  text-origin left bot
  color 255 255 255 255
  fill-color 76 76 76 255
  visible
  exportable
  stipple-scale 15
}

style 0x101 "@dxf-h1" {
  width 1.5
  text-height 1
  text-height-as mm
  text-origin left bot
  color 255 255 255 255
  fill-color 76 76 76 255
  visible
  exportable
  stipple-scale 15
}


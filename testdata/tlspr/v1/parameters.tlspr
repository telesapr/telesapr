telesapr 1

units mm

param width = 60
param height = width*2/3
param margin = height/5
param hole = margin*0.8

group 0x1 sketch-3d "#references" {
  color 0 0 0 0
  visible
  scale 0
}

group 0x2 sketch-in-plane "sketch-in-plane" {
  order 1
  subtype point-ortho
  workplane 0x80020000
  color 0 0 0 0
  predef {
    q 1 0 0 0
    origin 0x10001
  }
  visible
  scale 0
}

group 0x3 extrude "plate" {
  order 2
  subtype one-sided
  op-a 0x2
  color 100 100 100 255
  predef {
    entity-b 0x80020000

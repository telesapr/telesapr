telesapr 2

units mm

group 0x1 sketch-3d "#references" {
  color 0 0 0 0
  visible
}

group 0x2 sketch-in-plane "sketch-in-plane" {
  order 1
  subtype point-ortho
  workplane 0x80020000
  color 0 0 0 0
  predef {
    q 1 0 0 0
    origin 0x10001
  }
  visible
}

group 0x3 link "normal" {
  order 2
  workplane 0x10000
  color 100 100 100 255
  combine assemble
  visible
  link "normal.tlspr"
  remap {
    map 1 0x10000 0
    map 2 0x10001 0
    map 3 0x10020 0
    map 4 0x20000 0
    map 5 0x20001 0
    map 6 0x20020 0
    map 7 0x30000 0

# The pictures of limits.md: a line given a minimum of 40, grown to it,
# and a maximum of 50; its end dragged out, stopping at the maximum; a
# point put on a segment.
cursor on
key s
move 200 250
down L 200 250
up L 200 250
move 350 250
down L 350 250
up L 350 250
key esc
move 275 250
down L 275 250
up L 275 250
shot limits-1-line-selected
menu Constrain|Minimum Dimension
edit 40
cursor off
shot limits-2-min gw
move 275 250
down L 275 250
up L 275 250
menu Constrain|Maximum Dimension
edit 50
key esc
cursor off
shot limits-3-max gw
# The right end dragged out past the maximum: the line stops at 50.
cursor on
move 375 250
down L 375 250
move 400 250 L
move 440 250 L
move 480 250 L
shot limits-4-drag-stops gw
up L 480 250
key esc
# A point below the line, put on it with On Segment.
key p
move 340 450
down L 340 450
up L 340 450
key esc
move 340 450
down L 340 450
up L 340 450
move 400 250
down L 400 250
up L 400 250
shot limits-5-point-and-line gw
menu Constrain|On Segment
key esc
cursor off
shot limits-6-on-segment gw

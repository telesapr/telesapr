# The browser version in app/ (copied there by scripts/deploy-site.sh):
# a browser that takes brotli is sent telesapr-web.wasm.br, a fifth of the
# size, as telesapr-web.wasm with Content-Encoding: br. mod_mime sets both
# headers from the two extensions; no-gzip keeps mod_deflate off it.
AddType application/wasm .wasm
AddEncoding br .br
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Accept-Encoding} \bbr\b
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(app/.+\.wasm)$ $1.br [L,E=no-gzip:1]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.wasm(\.br)?$">
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>
